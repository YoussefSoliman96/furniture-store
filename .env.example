# Postgres connection. Locally: npm run db:local (embedded Postgres on port 5433).
# Supabase (Connect → pooler; the direct db.*.supabase.co host is IPv6-only):
# Session pooler (5432) for both: the transaction pooler (6543) hangs with postgres.js.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_MIGRATION_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
# Used by drizzle-kit only; falls back to DATABASE_URL (fine for local Postgres).
DATABASE_MIGRATION_URL=
# Connections per server process (build runs one per CPU). 2 is plenty locally.
DATABASE_POOL_MAX=2
NEXT_PUBLIC_SITE_URL=https://example.com

# Supabase API (Storage/Auth). The secret key is server-only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Admin account created/updated by `npm run db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-random-password
ADMIN_NAME=Admin

# Optional non-admin test account (to verify the dashboard is admin-only)
SEED_CUSTOMER_EMAIL=
SEED_CUSTOMER_PASSWORD=

# Dev only (`next dev`): open the dashboard already signed in as ADMIN_EMAIL.
# "Sign out" pauses it until you sign in manually. Ignored in production builds.
DEV_AUTO_LOGIN=false
