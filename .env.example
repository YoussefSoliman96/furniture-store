# Postgres connection. Locally: npm run db:local (embedded Postgres on port 5433).
# Supabase: Project Settings → Database → Connection string (use the pooler URL).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
# Connections per server process (build runs one per CPU). 2 is plenty locally.
DATABASE_POOL_MAX=2
NEXT_PUBLIC_SITE_URL=https://example.com

# Admin account created/updated by `npm run db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-random-password
ADMIN_NAME=Admin

# Optional non-admin test account (to verify the dashboard is admin-only)
SEED_CUSTOMER_EMAIL=
SEED_CUSTOMER_PASSWORD=
