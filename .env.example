# Postgres connection. Locally: npm run db:local (PGlite on port 5433).
# Supabase: Project Settings → Database → Connection string (use the pooler URL).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable
NEXT_PUBLIC_SITE_URL=https://example.com

# Admin account created/updated by `npm run db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-random-password
ADMIN_NAME=Admin

# Optional non-admin test account (to verify the dashboard is admin-only)
SEED_CUSTOMER_EMAIL=
SEED_CUSTOMER_PASSWORD=
